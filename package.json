{
  "name": "keronshans-blog",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  },
  "scripts": {
    "content:checkout": "node scripts/checkout-content.cjs",
    "predev": "npm run content:checkout && node scripts/generate-content-snapshot.cjs",
    "dev": "node scripts/with-wrangler-env.cjs next dev",
    "prebuild": "npm run content:checkout && node scripts/with-wrangler-env.cjs node scripts/generate-content-snapshot.cjs",
    "build": "node scripts/with-wrangler-env.cjs next build",
    "prebuild:cloudflare": "npm run content:checkout && node scripts/clean-build-output.cjs",
    "build:cloudflare": "node scripts/with-wrangler-env.cjs opennextjs-cloudflare build",
    "postbuild:cloudflare": "node scripts/with-wrangler-env.cjs opennextjs-cloudflare populateCache local && node scripts/seal-release.cjs",
    "preview": "npm run build:cloudflare && npm run preview:built",
    "preview:built": "node scripts/with-wrangler-env.cjs opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "next lint",
    "test:manager": "node --test desktop-manager/*.test.cjs",
    "test:search": "node --test src/lib/search.test.ts",
    "test:publisher": "node --test scripts/publish-content.test.cjs",
    "test:publisher-selection": "node --test scripts/publish-selection.test.cjs",
    "test:search-index": "node --test scripts/build-search-index.test.cjs",
    "test:release": "node --test scripts/release-controller.test.cjs scripts/content-runtime.test.cjs",
    "test:migration-map": "node --test scripts/audit-migration-map.test.cjs",
    "precheck": "node scripts/init-content-module.cjs",
    "check": "npm run lint && npm run test:manager && npm run test:search && npm run test:search-index && npm run test:publisher && npm run test:publisher-selection && npm run test:release && npm run test:migration-map && npx tsc --noEmit",
    "check:site": "node scripts/check-site.cjs",
    "deploy": "npm run build:cloudflare && npm run deploy:built",
    "deploy:built": "node scripts/with-wrangler-env.cjs opennextjs-cloudflare deploy",
    "predeploy:built": "node scripts/seal-release.cjs --verify",
    "manager": "electron desktop-manager/main.cjs",
    "publish:content": "node scripts/publish-content.cjs",
    "content:check": "node scripts/content-check.cjs",
    "content:verify": "node scripts/content-verify.cjs",
    "content:search": "node scripts/build-search-index.cjs",
    "content:migrate": "node scripts/migrate-content.cjs",
    "content:export-d1": "node scripts/export-d1-content.cjs",
    "content:merge": "node scripts/merge-content.cjs",
    "content:migration-audit": "node scripts/audit-migration-map.cjs",
    "content:export": "node scripts/publish-content.cjs --dry-run",
    "content:publish": "node scripts/publish-content.cjs",
    "content:publish-selection": "node scripts/publish-selection.cjs",
    "dev:web": "npm run dev"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.12",
    "katex": "^0.16.44",
    "next": "^15.5.25",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "electron": "^42.3.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
